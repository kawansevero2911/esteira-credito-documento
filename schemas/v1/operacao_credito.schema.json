{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "operacao_credito.v1",
  "title": "OperacaoCredito",
  "description": "Contrato de entrada: dados de uma operação de crédito enviados pelos módulos da Esteira.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id_operacao", "tipo_produto", "cliente", "valor", "prazo_meses", "taxa_juros_mensal"],
  "properties": {
    "id_operacao": {"type": "string", "minLength": 1, "description": "Identificador único da operação."},
    "tipo_produto": {
      "type": "string",
      "enum": ["financiamento_imovel", "financiamento_automovel", "credito_pessoal"]
    },
    "cliente": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nome", "documento"],
      "properties": {
        "nome": {"type": "string", "minLength": 1},
        "documento": {"type": "string", "minLength": 1}
      }
    },
    "valor": {"type": "number", "exclusiveMinimum": 0, "description": "Valor da operação em reais."},
    "prazo_meses": {"type": "integer", "minimum": 1},
    "taxa_juros_mensal": {"type": "number", "minimum": 0, "description": "Taxa em % ao mês (1.35 = 1,35%)."}
  }
}
